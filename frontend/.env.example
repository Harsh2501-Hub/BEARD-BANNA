# BEARD BANNA — Supabase Configuration Reference
# =================================================
# This file documents the environment/configuration values
# needed for the Supabase authentication system.
#
# Since the frontend is vanilla HTML/JS (no bundler/Vite),
# these values are set in:
#   frontend/js/supabase-config.js
#
# Get your values from:
#   Supabase Dashboard → Settings → API
# =================================================

# Your Supabase project URL
# Example: https://abcdefghijklmn.supabase.co
SUPABASE_URL=YOUR_SUPABASE_URL

# Your Supabase anon/public key (safe for frontend use)
# Starts with: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NEVER use the service_role key in frontend code
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# =================================================
# Backend env vars (existing — do not change)
# Located in: backend/.env
# =================================================
PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret_for_admin_auth
