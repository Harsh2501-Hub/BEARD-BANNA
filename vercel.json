{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin-panel/(.*)", "destination": "/admin-panel/$1" },
    { "source": "/admin-panel", "destination": "/admin-panel/login.html" },
    { "source": "/admin", "destination": "/admin-panel/login.html" },
    { "source": "/collection", "destination": "/frontend/collection.html" },
    { "source": "/product", "destination": "/frontend/product.html" },
    { "source": "/cart", "destination": "/frontend/cart.html" },
    { "source": "/wishlist", "destination": "/frontend/wishlist.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/register", "destination": "/frontend/register.html" },
    { "source": "/profile", "destination": "/frontend/profile.html" },
    { "source": "/account", "destination": "/frontend/profile.html" },
    { "source": "/track-order", "destination": "/frontend/track-order.html" },
    { "source": "/creator", "destination": "/frontend/creator.html" },
    { "source": "/reset-password", "destination": "/frontend/reset-password.html" },
    { "source": "/forgot-password", "destination": "/frontend/forgot-password.html" },
    { "source": "/order-success", "destination": "/frontend/order-success.html" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
